{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**",
      "maxDuration": 180
    },
    "api/cron/catalog-full-sync.js": {
      "includeFiles": "server/**",
      "maxDuration": 180
    },
    "api/cron/catalog-warehouse-sync.js": {
      "includeFiles": "server/**",
      "maxDuration": 180
    },
    "api/cron/auto-inventory.js": {
      "includeFiles": "server/**",
      "maxDuration": 180
    },
    "api/cron/gmail-watch.js": {
      "includeFiles": "server/**",
      "maxDuration": 60
    },
    "api/cron/shopify-availability-sync.js": {
      "includeFiles": "server/**",
      "maxDuration": 180
    }
  },
  "crons": [
    {
      "path": "/api/cron/catalog-warehouse-sync",
      "schedule": "0 0-3,13-23 * * *"
    },
    {
      "path": "/api/cron/catalog-full-sync",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/auto-inventory",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/gmail-watch",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/shopify-availability-sync",
      "schedule": "* * * * *"
    }
  ],
  "routes": [
    {
      "src": "/extension/install.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Content-Security-Policy": "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
        "Content-Type": "text/html; charset=utf-8",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/extension/updates.xml",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Content-Type": "application/xml; charset=utf-8",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/extension/stockbridge.crx",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Content-Type": "application/x-chrome-extension",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/extension/install-stockbridge-extension.reg",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Content-Disposition": "attachment; filename=install-stockbridge-extension.reg",
        "Content-Type": "application/octet-stream",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(audits|auth|backorders|status|email|import|integrations|notes|notifications|price-audit|products|shopify|users|vendors)(.*)",
      "dest": "api/index.js"
    }
  ]
}
